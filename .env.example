# =============================================================================
# EXPLAINABLE AI DIABETES SYSTEM: ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and populate with your personal credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# Set LLM_PROVIDER to 'openai' or 'gemini'
# If LLM_API_KEY is left blank, the application automatically uses a
# deterministic 12-section clinical template fallback without crashing.
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Alternative Gemini configuration:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=

# -----------------------------------------------------------------------------
# SMTP Email Dispatch Configuration
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Generate a 16-character "App Password" (do NOT use your standard password).
# 3. Enter your Gmail address in EMAIL_USERNAME and SENDER_EMAIL.
# 4. Paste the 16-character App Password in EMAIL_PASSWORD.
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
SENDER_EMAIL=
